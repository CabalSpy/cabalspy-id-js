{
  "name": "cabalspy-id",
  "version": "0.9.0",
  "description": "SocialFi API & SDK for CabalSpy ID — add a social layer to any app: login with X + verified wallets, live trades and PnL of your users, token theses, leaderboards and copy trading on Solana, BNB Chain, Base, Ethereum and Robinhood Chain.",
  "keywords": [
    "socialfi",
    "socialfi-api",
    "socialfi-sdk",
    "socialfi-widget",
    "social-trading",
    "copy-trading",
    "crypto-social",
    "web3-social",
    "kol",
    "kol-tracker",
    "wallet-tracker",
    "trading-leaderboard",
    "pnl",
    "token-thesis",
    "crypto-login",
    "oidc",
    "openid-connect",
    "solana",
    "bnb",
    "base",
    "ethereum",
    "cabalspy",
    "react",
    "typescript",
    "sdk"
  ],
  "license": "MIT",
  "homepage": "https://id.cabalspy.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CabalSpy/cabalspy-id-js.git"
  },
  "bugs": {
    "url": "https://github.com/CabalSpy/cabalspy-id-js/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js",
      "require": "./dist/api.cjs"
    },
    "./thesis": {
      "types": "./dist/thesis.d.ts",
      "import": "./dist/thesis.js",
      "require": "./dist/thesis.cjs"
    },
    "./widget": {
      "types": "./dist/widget.d.ts",
      "import": "./dist/widget.js",
      "require": "./dist/widget.cjs"
    },
    "./widget/react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "api": [
        "./dist/api.d.ts"
      ],
      "thesis": [
        "./dist/thesis.d.ts"
      ],
      "widget": [
        "./dist/widget.d.ts"
      ],
      "widget/react": [
        "./dist/react.d.ts"
      ],
      "react": [
        "./dist/react.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "ws": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4",
    "ws": "^8.22.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
